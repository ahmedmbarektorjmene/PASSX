import { Theme } from "../theme.slint";
import { PrimaryButton, SecondaryButton } from "../components.slint";

export component LaunchScreen inherits Rectangle {
    callback create-new-vault();
    callback open-existing-vault();
    background: Theme.background;
    
    // Abstract Background Glow Orbs
    Rectangle {
        x: -100px;
        y: 50px;
        width: 400px;
        height: 400px;
        background: Theme.primary-glow;
        border-radius: 200px;
        opacity: 0.06;
    }

    Rectangle {
        x: parent.width - 200px;
        y: parent.height - 250px;
        width: 350px;
        height: 350px;
        background: Theme.accent-glow;
        border-radius: 175px;
        opacity: 0.05;
    }

    VerticalLayout {
        alignment: center;
        spacing: 40px;
        padding: 40px;

        // Hero Section
        VerticalLayout {
            spacing: 20px;

            // Shield icon with glow ring - centered via HorizontalLayout
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 100px;
                    height: 100px;

                    // Outer glow ring
                    Rectangle {
                        width: 100px;
                        height: 100px;
                        border-radius: 50px;
                        background: Theme.primary-glow;
                        border-width: 1px;
                        border-color: Theme.primary-glow;
                    }

                    Image {
                        source: @image-url("../../../assets/vault.svg");
                        width: 56px;
                        height: 56px;
                        colorize: Theme.primary;
                        x: 22px;
                        y: 22px;
                    }
                }
            }

            Text {
                text: "PassX";
                font-size: 52px;
                font-weight: 900;
                horizontal-alignment: center;
                color: Theme.text-primary;
                letter-spacing: -1.5px;
            }

            Text {
                text: "THE NEXT GENERATION OF LOCAL SECURITY";
                font-size: 11px;
                font-weight: 800;
                horizontal-alignment: center;
                color: Theme.primary;
                letter-spacing: 3px;
            }

            // Tagline
            Text {
                text: "Keep your passwords safe, offline, and under your control.";
                font-size: 14px;
                font-weight: 400;
                horizontal-alignment: center;
                color: Theme.text-muted;
            }
        }

        // Action Block - centered via HorizontalLayout wrapper
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                spacing: 12px;
                width: 360px;
                PrimaryButton {
                    text: "Open Vault";
                    height: 52px;
                    clicked => {
                        root.open-existing-vault();
                    }
                }
            }
        }

        // Trust Indicators
        VerticalLayout {
            spacing: 16px;

            // Feature pills row
            HorizontalLayout {
                spacing: 12px;
                alignment: center;
                Rectangle {
                    height: 28px;
                    border-radius: 14px;
                    background: Theme.primary-glow;
                    border-width: 1px;
                    border-color: Theme.primary-glow;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 6px;
                        alignment: center;
                        Text {
                            text: "🔒";
                            font-size: 11px;
                            vertical-alignment: center;
                        }

                        Text {
                            text: "Chacha20-Poly1305";
                            font-size: 10px;
                            font-weight: 700;
                            color: Theme.primary;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    height: 28px;
                    border-radius: 14px;
                    background: Theme.success-soft;
                    border-width: 1px;
                    border-color: Theme.success-soft;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 6px;
                        alignment: center;
                        Text {
                            text: "🛡️";
                            font-size: 11px;
                            vertical-alignment: center;
                        }

                        Text {
                            text: "TPM 2.0";
                            font-size: 10px;
                            font-weight: 700;
                            color: Theme.success;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    height: 28px;
                    border-radius: 14px;
                    background: Theme.accent-glow;
                    border-width: 1px;
                    border-color: Theme.accent-glow;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 6px;
                        alignment: center;
                        Text {
                            text: "⚡";
                            font-size: 11px;
                            vertical-alignment: center;
                        }

                        Text {
                            text: "Argon2id";
                            font-size: 10px;
                            font-weight: 700;
                            color: Theme.accent;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Text {
                text: "Zero-knowledge architecture — your data never leaves your device.";
                font-size: 11.5px;
                color: Theme.text-muted;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}
