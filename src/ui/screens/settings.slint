// Settings Screen — Separate Password and TOTP import/export
import { Theme } from "../theme.slint";
import { LineEdit } from "std-widgets.slint";
import {
    PrimaryButton,
    SecondaryButton,
    Divider,
    Label,
} from "../components.slint";

export component SettingsScreen inherits Rectangle {
    callback back();
    callback export-passwords();
    callback export-totps();
    callback import-passwords();
    callback import-totps();
    in property <string> status-message: "";

    // Mirroring
    in property <[string]> mirrors: [];
    callback add-mirror();
    callback remove-mirror(int);
    callback sync-mirrors();
    
    // Change Password Logic
    in-out property <bool> show-change-password-modal: false;
    callback change-master-password(string, string); // current, new

    // Theme (Light / Dark / System)
    in property <string> current-mode; // "light", "dark", "system"
    callback set-mode(string);
    background: Theme.background;
    VerticalLayout {
        padding: 40px;
        spacing: 24px;

        // ─── Header ───
        HorizontalLayout {
            spacing: 14px;
            alignment: start;

            // Back button (top-left)
            Rectangle {
                width: 38px;
                height: 38px;
                border-radius: Theme.border-radius;
                background: back-touch.has-hover ? Theme.surface-hover : Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                animate background { duration: 200ms; }
                back-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.back();
                    }
                }

                Text {
                    text: "←";
                    font-size: 16px;
                    color: Theme.text-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: 12px;
                background: Theme.accent-glow;
                Image {
                    source: @image-url("../../../assets/settings.svg");
                    width: 22px;
                    height: 22px;
                    colorize: Theme.accent;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text {
                    text: "Settings";
                    font-size: Theme.font-size-h1;
                    font-weight: 800;
                    color: Theme.text-primary;
                }

                Text {
                    text: "Import & export your vault data";
                    font-size: Theme.font-size-small;
                    color: Theme.text-muted;
                }
            }
        }

        Divider { }

        // ─── Passwords Section ───
        VerticalLayout {
            spacing: 12px;
            Text {
                text: "PASSWORDS";
                font-size: 10px;
                font-weight: 800;
                color: Theme.text-disabled;
                letter-spacing: 1.5px;
            }

            HorizontalLayout {
                spacing: 12px;

                // Export Passwords
                Rectangle {
                    horizontal-stretch: 1;
                    height: 72px;
                    border-radius: Theme.border-radius-lg;
                    background: ep-touch.has-hover ? Theme.surface-hover : Theme.surface;
                    border-width: 1px;
                    border-color: ep-touch.has-hover ? Theme.primary : Theme.border;
                    animate background { duration: 200ms; }
                    animate border-color { duration: 200ms; }
                    ep-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.export-passwords();
                        }
                    }

                    HorizontalLayout {
                        padding: 16px;
                        spacing: 12px;
                        Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: 10px;
                            background: Theme.accent-glow;
                            Image {
                                source: @image-url("../../../assets/copy.svg");
                                width: 16px;
                                height: 16px;
                                colorize: Theme.accent;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "Export Passwords";
                                font-size: 13px;
                                font-weight: 700;
                                color: Theme.text-primary;
                            }

                            Text {
                                text: "Chromium-compatible CSV/JSON";
                                font-size: 11px;
                                color: Theme.text-muted;
                            }
                        }
                    }
                }

                // Import Passwords
                Rectangle {
                    horizontal-stretch: 1;
                    height: 72px;
                    border-radius: Theme.border-radius-lg;
                    background: ip-touch.has-hover ? Theme.surface-hover : Theme.surface;
                    border-width: 1px;
                    border-color: ip-touch.has-hover ? Theme.primary : Theme.border;
                    animate background { duration: 200ms; }
                    animate border-color { duration: 200ms; }
                    ip-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.import-passwords();
                        }
                    }

                    HorizontalLayout {
                        padding: 16px;
                        spacing: 12px;
                        Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: 10px;
                            background: Theme.accent-glow;
                            Image {
                                source: @image-url("../../../assets/folder.svg");
                                width: 16px;
                                height: 16px;
                                colorize: Theme.accent;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "Import Passwords";
                                font-size: 13px;
                                font-weight: 700;
                                color: Theme.text-primary;
                            }

                            Text {
                                text: "From CSV or JSON file";
                                font-size: 11px;
                                color: Theme.text-muted;
                            }
                        }
                    }
                }
            }
        }

        // ─── Authenticators Section ───
        VerticalLayout {
            spacing: 12px;
            Text {
                text: "AUTHENTICATORS (TOTP)";
                font-size: 10px;
                font-weight: 800;
                color: Theme.text-disabled;
                letter-spacing: 1.5px;
            }

            HorizontalLayout {
                spacing: 12px;

                // Export TOTPs
                Rectangle {
                    horizontal-stretch: 1;
                    height: 72px;
                    border-radius: Theme.border-radius-lg;
                    background: et-touch.has-hover ? Theme.surface-hover : Theme.surface;
                    border-width: 1px;
                    border-color: et-touch.has-hover ? Theme.primary : Theme.border;
                    animate background { duration: 200ms; }
                    animate border-color { duration: 200ms; }
                    et-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.export-totps();
                        }
                    }

                    HorizontalLayout {
                        padding: 16px;
                        spacing: 12px;
                        Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: 10px;
                            background: Theme.accent-glow;
                            Image {
                                source: @image-url("../../../assets/copy.svg");
                                width: 16px;
                                height: 16px;
                                colorize: Theme.accent;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "Export Authenticators";
                                font-size: 13px;
                                font-weight: 700;
                                color: Theme.text-primary;
                            }

                            Text {
                                text: "TOTP secrets as CSV/JSON";
                                font-size: 11px;
                                color: Theme.text-muted;
                            }
                        }
                    }
                }

                // Import TOTPs
                Rectangle {
                    horizontal-stretch: 1;
                    height: 72px;
                    border-radius: Theme.border-radius-lg;
                    background: it-touch.has-hover ? Theme.surface-hover : Theme.surface;
                    border-width: 1px;
                    border-color: it-touch.has-hover ? Theme.primary : Theme.border;
                    animate background { duration: 200ms; }
                    animate border-color { duration: 200ms; }
                    it-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.import-totps();
                        }
                    }

                    HorizontalLayout {
                        padding: 16px;
                        spacing: 12px;
                        Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: 10px;
                            background: Theme.accent-glow;
                            Image {
                                source: @image-url("../../../assets/folder.svg");
                                width: 16px;
                                height: 16px;
                                colorize: Theme.accent;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "Import Authenticators";
                                font-size: 13px;
                                font-weight: 700;
                                color: Theme.text-primary;
                            }

                            Text {
                                text: "From CSV or JSON file";
                                font-size: 11px;
                                color: Theme.text-muted;
                            }
                        }
                    }
                }
            }
        }

        // ─── Security Section ───
        VerticalLayout {
            spacing: 12px;
            Text {
                text: "SECURITY";
                font-size: 10px;
                font-weight: 800;
                color: Theme.text-disabled;
                letter-spacing: 1.5px;
            }

            Rectangle {
                height: 72px;
                border-radius: Theme.border-radius-lg;
                background: cp-touch.has-hover ? Theme.surface-hover : Theme.surface;
                border-width: 1px;
                border-color: cp-touch.has-hover ? Theme.primary : Theme.border;
                animate background { duration: 200ms; }
                animate border-color { duration: 200ms; }
                cp-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.show-change-password-modal = true;
                    }
                }

                HorizontalLayout {
                    padding: 16px;
                    spacing: 12px;
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 10px;
                        background: Theme.danger-soft;
                        Image {
                            source: @image-url("../../../assets/lock.svg");
                            width: 16px;
                            height: 16px;
                            colorize: Theme.danger;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "Change Master Password";
                            font-size: 13px;
                            font-weight: 700;
                            color: Theme.text-primary;
                        }

                        Text {
                            text: "Update the key used to encrypt your vault";
                            font-size: 11px;
                            color: Theme.text-muted;
                        }
                    }
                }
            }
        }

        // ─── Mirrors Section ───
        VerticalLayout {
            spacing: 12px;
            Text {
                text: "VAULT MIRRORS";
                font-size: 10px;
                font-weight: 800;
                color: Theme.text-disabled;
                letter-spacing: 1.5px;
            }

            // List of Mirrors
             VerticalLayout {
                spacing: 8px;
                for mirror[idx] in root.mirrors: Rectangle {
                    height: 48px;
                    border-radius: Theme.border-radius;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 12px;
                        alignment: center;
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: 6px;
                            background: Theme.accent-glow;
                            Image {
                                source: @image-url("../../../assets/folder.svg");
                                width: 12px;
                                height: 12px;
                                colorize: Theme.accent;
                            }
                        }

                        Text {
                            text: mirror;
                            font-size: 12px;
                            color: Theme.text-primary;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        
                        // Remove button
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: 4px;
                            background: rm-touch.has-hover ? Theme.danger-soft : transparent;
                            rm-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.remove-mirror(idx);
                                }
                            }

                            Text {
                                text: "×";
                                color: rm-touch.has-hover ? Theme.danger : Theme.text-muted;
                                font-size: 16px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 12px;
                
                // Add Mirror
                Rectangle {
                    horizontal-stretch: 1;
                    height: 40px;
                    border-radius: Theme.border-radius;
                    background: am-touch.has-hover ? Theme.surface-hover : Theme.surface;
                    border-width: 1px;
                    border-color: am-touch.has-hover ? Theme.primary : Theme.border; // Fix hover color
                    am-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.add-mirror();
                        }
                    }

                    Text {
                        text: "+ Add Mirror Location";
                        font-size: 12px;
                        color: Theme.primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Sync Now
                Rectangle {
                    width: 100px;
                    height: 40px;
                    border-radius: Theme.border-radius;
                    background: sn-touch.has-hover ? Theme.accent-glow : Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    sn-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.sync-mirrors();
                        }
                    }

                    Text {
                        text: "Sync Now";
                        font-size: 12px;
                        color: Theme.accent;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // ─── Theme Section ───
        VerticalLayout {
            spacing: 12px;
            Text {
                text: "THEME";
                font-size: 10px;
                font-weight: 800;
                color: Theme.text-disabled;
                letter-spacing: 1.5px;
            }

            HorizontalLayout {
                spacing: 12px;
                
                // Light
                Rectangle {
                    horizontal-stretch: 1;
                    height: 40px;
                    border-radius: Theme.border-radius;
                    background: root.current-mode == "light" ? Theme.primary-glow : (touch-light.has-hover ? Theme.surface-hover : Theme.surface);
                    border-width: 1px;
                    border-color: root.current-mode == "light" ? Theme.primary : Theme.border;
                    touch-light := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.set-mode("light");
                        }
                    }

                    Text {
                        text: "Light";
                        color: root.current-mode == "light" ? Theme.primary : Theme.text-primary;
                        font-size: 12px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Dark
                Rectangle {
                    horizontal-stretch: 1;
                    height: 40px;
                    border-radius: Theme.border-radius;
                    background: root.current-mode == "dark" ? Theme.primary-glow : (touch-dark.has-hover ? Theme.surface-hover : Theme.surface);
                    border-width: 1px;
                    border-color: root.current-mode == "dark" ? Theme.primary : Theme.border;
                    touch-dark := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.set-mode("dark");
                        }
                    }

                    Text {
                        text: "Dark";
                        color: root.current-mode == "dark" ? Theme.primary : Theme.text-primary;
                        font-size: 12px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // System
                Rectangle {
                    horizontal-stretch: 1;
                    height: 40px;
                    border-radius: Theme.border-radius;
                    background: root.current-mode == "system" ? Theme.primary-glow : (touch-sys.has-hover ? Theme.surface-hover : Theme.surface);
                    border-width: 1px;
                    border-color: root.current-mode == "system" ? Theme.primary : Theme.border;
                    touch-sys := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.set-mode("system");
                        }
                    }

                    Text {
                        text: "System";
                        color: root.current-mode == "system" ? Theme.primary : Theme.text-primary;
                        font-size: 12px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // ─── Status Feedback ───
        if (root.status-message != ""): Rectangle {
            height: 40px;
            border-radius: Theme.border-radius;
            background: Theme.success-soft;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 8px;
                alignment: start;
                Text {
                    text: "✓";
                    font-size: 13px;
                    color: Theme.success;
                    vertical-alignment: center;
                }

                Text {
                    text: root.status-message;
                    font-size: 13px;
                    font-weight: 600;
                    color: Theme.success;
                    vertical-alignment: center;
                }
            }
        }

        // Spacer
        Rectangle {
            vertical-stretch: 1;
        }
    }

    // ─── Change Password Modal ───
    if (root.show-change-password-modal): Rectangle {
        background: rgba(0, 0, 0, 0.6);
        TouchArea {
            clicked => {
                // Optional: Close on outside click? Better not to avoid accidental loss.
                // root.show-change-password-modal = false;
            }
        }

        modal-content := Rectangle {
            width: 420px;
            height: 400px;
            background: Theme.surface;
            border-radius: Theme.border-radius-xl;
            border-width: 1px;
            border-color: Theme.border;

            // Internal State for inputs
            property <string> current-password;
            property <string> new-password;
            property <string> confirm-new-password;
            VerticalLayout {
                padding: 28px;
                spacing: 20px;
                Text {
                    text: "Change Master Password";
                    font-size: 18px;
                    font-weight: 800;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                }

                VerticalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        spacing: 6px;
                        Label {
                            text: "CURRENT PASSWORD";
                        }

                        LineEdit {
                            placeholder-text: "Enter current password";
                            input-type: InputType.password;
                            font-size: 13px;
                            edited(t) => {
                                modal-content.current-password = t;
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.border-subtle;
                    }

                    VerticalLayout {
                        spacing: 6px;
                        Label {
                            text: "NEW PASSWORD";
                        }

                        LineEdit {
                            placeholder-text: "Enter new password";
                            input-type: InputType.password;
                            font-size: 13px;
                            edited(t) => {
                                modal-content.new-password = t;
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 6px;
                        Label {
                            text: "CONFIRM NEW PASSWORD";
                        }

                        LineEdit {
                            placeholder-text: "Re-enter new password";
                            input-type: InputType.password;
                            font-size: 13px;
                            edited(t) => {
                                modal-content.confirm-new-password = t;
                            }
                        }
                    }
                }

                // Error/Success Message for Modal
                if (modal-content.new-password != "" && modal-content.new-password != modal-content.confirm-new-password): Text {
                    text: "Passwords do not match";
                    color: Theme.danger;
                    font-size: 12px;
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    spacing: 12px;
                    alignment: center;
                    SecondaryButton {
                        text: "Cancel";
                        width: 120px;
                        clicked => {
                            root.show-change-password-modal = false;
                        }
                    }

                    PrimaryButton {
                        text: "Change Password";
                        width: 160px;
                        enabled: modal-content.current-password != "" && modal-content.new-password != "" && modal-content.new-password == modal-content.confirm-new-password;
                        clicked => {
                            root.change-master-password(modal-content.current-password, modal-content.new-password);
                            root.show-change-password-modal = false;
                        }
                    }
                }
            }
        }
    }
}
