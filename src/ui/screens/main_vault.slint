import { Theme } from "../theme.slint";
import {
    SidebarItem,
    VaultEntryItem,
    IconButton,
    PrimaryButton,
    SecondaryButton,
    DangerButton,
    Divider,
    Card,
    StatusBadge,
    ContextMenuItem,
    ConfirmDialog,
    Label,
} from "../components.slint";
import { ScrollView, LineEdit } from "std-widgets.slint";
import { TotpCard } from "./totp_card.slint";
import { DetailPanel } from "./detail_panel.slint";
import { AccountModal } from "./account_modal.slint";
import { TotpModal } from "./totp_modal.slint";
import { SelectTotpModal } from "./select_totp_modal.slint";

// Tabs
import { AccountsTab } from "../tabs/accounts_tab.slint";
import { TotpTab } from "../tabs/totp_tab.slint";
import { TrashTab } from "../tabs/trash_tab.slint";
import { VaultEntryData, GeneratorSettings } from "../types.slint";

export component MainVaultScreen inherits Rectangle {
    in property <[VaultEntryData]> entries;
    in property <string> selected-entry-id;
    in-out property <string> revealed-password;
    in-out property <bool> is-password-revealed;
    in property <float> totp-progress;
    callback open-generator();
    callback open-settings();

    // Filtering
    callback perform-search(string, string); // query, category

    // Actions
    callback select-entry(string);
    callback lock-vault();
    callback save-entry(string, string, string, string, string, string); // id, title, username, password, url, notes

    callback save-totp(string, string, string, string, string); // id, name, secret, issuer, linked_account_id
    callback link-totp(string, string); // totp_id, account_id
    callback unlink-totp(string); // account_id (to find the linked totp)
    callback toggle-favorite(string);
    callback delete-entry(string);
    callback restore-entry(string);
    callback copy-username(string);
    callback copy-password(string);
    callback reveal-password(string);
    callback copy-to-clipboard(string);
    // New callback to fetch details synchronously
    callback get-entry-details(string) -> VaultEntryData;
    callback copy-totp-code(string);
    
    // Secure Edit Callbacks
    callback request-edit-entry(string);
    callback request-edit-totp(string);

    // Removed direct authorized functions in favor of property triggers


    // Generator Callbacks
    callback generate-password-from-settings() -> string;
    callback save-generator-settings(int, bool, bool, bool, bool);
    callback get-generator-settings() -> GeneratorSettings;


    // QR Code Scanning
    callback scan-qr-from-screen();
    callback scan-qr-from-clipboard();
    callback scan-qr-from-file();
    in-out property <string> qr-scan-error: "";
    in-out property <string> qr-scanned-account: "";
    in-out property <string> qr-scanned-secret: "";
    in-out property <string> qr-scanned-issuer: "";
    background: Theme.background;

    // State
    property <string> current-filter: "accounts";
    property <string> current-search: "";
    property <bool> show-modal: false;
    in-out property <bool> show-totp-modal: false;

    // Secure Edit Signals (Inputs)
    in property <string> auth-edit-id;
    in property <int> auth-edit-tick;
    in property <string> auth-totp-id;
    in property <int> auth-totp-tick;
    changed auth-edit-tick => {
        if (root.auth-edit-tick > 0) {
            root.edit-id = root.auth-edit-id;
            let d = root.get-entry-details(root.auth-edit-id);
            if (d.id == root.auth-edit-id) {
                root.edit-title = d.title;
                root.edit-username = d.username;
                root.edit-password = "";
                root.edit-url = d.url;
                root.edit-notes = d.notes;
                root.show-modal = true;
            }
        }
    }
    changed auth-totp-tick => {
        if (root.auth-totp-tick > 0) {
            let d = root.get-entry-details(root.auth-totp-id);
            if (d.id == root.auth-totp-id) {
                root.totp-edit-id = d.id;
                root.totp-name = d.title;
                root.totp-issuer = d.username;
                root.totp-secret = "";
                root.qr-scan-error = "";
                root.qr-scanned-account = "";
                root.qr-scanned-secret = "";
                root.qr-scanned-issuer = "";
                root.show-totp-modal = true;
            }
        }
    }
    property <string> edit-id: "";
    property <string> edit-title: "";
    property <string> edit-username: "";
    property <string> edit-password: "";
    property <string> edit-url: "";
    property <string> edit-notes: "";
    // TOTP modal fields
    property <string> totp-edit-id: "";
    property <string> totp-name: "";
    property <string> totp-issuer: "";
    property <string> totp-secret: "";
    // Context menu
    property <bool> show-context-menu: false;
    property <length> context-menu-x: 0px;
    property <length> context-menu-y: 0px;
    property <string> context-menu-entry-id: "";
    property <int> context-menu-entry-index: -1;
    // Confirm dialog
    property <bool> show-confirm-dialog: false;
    property <string> confirm-entry-id: "";
    
    // Select TOTP Modal
    property <bool> show-select-totp-modal: false;
    property <string> link-target-account-id: "";

    // --- Cached selected entry data (updated on selection or list refresh) ---
    property <bool> has-selection: root.selected-entry-id != "";
    property <string> sel-title: "";
    property <string> sel-username: "";
    property <string> sel-url: "";
    property <string> sel-icon-text: "";
    property <image> sel-icon;
    property <bool> sel-has-icon: false;
    property <bool> sel-deleted: false;
    property <bool> sel-has-totp: false;
    property <string> sel-totp-code: "";
    property <string> sel-entry-type: "account";
    property <string> sel-notes: "";

    // Refresh cached properties whenever entries or selection changes
    changed entries => {
        root.refresh-selection();
    }
    changed selected-entry-id => {
        root.refresh-selection();
        root.is-password-revealed = false;
        root.revealed-password = "";
    }
    function refresh-selection() {
        if (root.selected-entry-id == "") {
            return;
        }
        let d = root.get-entry-details(root.selected-entry-id);
        if (d.id == root.selected-entry-id) {
            root.sel-title = d.title;
            root.sel-username = d.username;
            root.sel-url = d.url;
            root.sel-icon-text = d.icon_text;
            root.sel-icon = d.icon;
            root.sel-has-icon = d.has_icon;
            root.sel-deleted = d.deleted;
            root.sel-has-totp = d.has_totp;
            root.sel-totp-code = d.totp_code;
            root.sel-entry-type = d.entry_type;
            root.sel-notes = d.notes;
        }
    }
    HorizontalLayout {
        // --- Sidebar ---
        Rectangle {
            width: 240px;
            horizontal-stretch: 0;
            background: Theme.background-alt;
            VerticalLayout {
                padding-top: 20px;
                padding-bottom: 16px;
                padding-left: 16px;
                padding-right: 16px;
                spacing: 20px;

                // Workspace Header
                Rectangle {
                    height: 52px;
                    border-radius: Theme.border-radius-lg;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 10px;
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            background: Theme.primary;
                            border-radius: 8px;
                            Text {
                                text: "P";
                                font-weight: 800;
                                font-size: 13px;
                                color: white;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            Text {
                                text: "Personal Vault";
                                color: Theme.text-primary;
                                font-weight: 700;
                                font-size: 13px;
                            }

                            Text {
                                text: "Encrypted · Local";
                                color: Theme.text-muted;
                                font-size: 9px;
                                font-weight: 600;
                                letter-spacing: 0.5px;
                            }
                        }
                    }
                }

                // Main Navigation
                VerticalLayout {
                    spacing: 2px;
                    SidebarItem {
                        text: "Accounts";
                        icon: @image-url("../../../assets/lock.svg");
                        selected: root.current-filter == "accounts";
                        clicked => {
                            root.current-filter = "accounts";
                            root.select-entry("");
                            root.perform-search(root.current-search, "accounts");
                        }
                    }

                    SidebarItem {
                        text: "Authenticators";
                        icon: @image-url("../../../assets/shield.svg");
                        selected: root.current-filter == "totp";
                        clicked => {
                            root.current-filter = "totp";
                            root.select-entry("");
                            root.perform-search(root.current-search, "totp");
                        }
                    }

                    SidebarItem {
                        text: "Trash";
                        icon: @image-url("../../../assets/trash.svg");
                        selected: root.current-filter == "trash";
                        clicked => {
                            root.current-filter = "trash";
                            root.select-entry("");
                            root.perform-search(root.current-search, "trash");
                        }
                    }
                }

                Divider { }

                // Password Generator tab
                VerticalLayout {
                    spacing: 2px;
                    SidebarItem {
                        text: "Password Generator";
                        icon: @image-url("../../../assets/generator.svg");
                        clicked => {
                            root.open-generator();
                        }
                    }

                    SidebarItem {
                        text: "Settings";
                        icon: @image-url("../../../assets/settings.svg");
                        clicked => {
                            root.open-settings();
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                // Lock button at very bottom
                Divider { }

                Rectangle {
                    height: 40px;
                    border-radius: Theme.border-radius;
                    background: lock-touch.has-hover ? Theme.danger-soft : Colors.transparent;
                    animate background { duration: 200ms; }
                    lock-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.lock-vault();
                        }
                    }

                    HorizontalLayout {
                        padding-left: 20px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../../../assets/lock.svg");
                                width: 18px;
                                height: 18px;
                                colorize: lock-touch.has-hover ? Theme.danger : Theme.text-muted;
                                animate colorize { duration: 200ms; }
                            }
                        }

                        Text {
                            text: "Lock Vault";
                            color: lock-touch.has-hover ? Theme.danger : Theme.text-muted;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                            animate color { duration: 200ms; }
                        }
                    }
                }
            }

            // Subtle sidebar border
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.border-subtle;
            }
        }

        // ===================================================================
        // TABS AREA
        // ===================================================================

        // 1. Accounts Tab
        if (root.current-filter == "accounts"): AccountsTab {
            horizontal-stretch: 0;
            width: 300px;
            entries: root.entries;
            selected-entry-id: root.selected-entry-id;
            current-search: root.current-search;
            search(query) => {
                root.current-search = query;
                root.perform-search(query, "accounts");
            }
            select-entry(id) => {
                root.select-entry(id);
                root.show-context-menu = false;
            }
            open-add-modal() => {
                root.edit-id = "";
                root.edit-title = "";
                root.edit-username = "";
                root.edit-password = "";
                root.edit-url = "";
                root.edit-notes = "";
                root.show-modal = true;
            }
            request-context-menu(id, idx, x, y) => {
                root.context-menu-entry-id = id;
                root.context-menu-entry-index = idx;
                root.context-menu-x = x + 240px; // Offset by sidebar
                root.context-menu-y = y;
                root.show-context-menu = true;
            }
        }

        // 2. Authenticators Tab
        if (root.current-filter == "totp"): TotpTab {
            horizontal-stretch: 1;
            entries: root.entries;
            current-search: root.current-search;
            progress: root.totp-progress;
            search(query) => {
                root.current-search = query;
                root.perform-search(query, "totp");
            }
            open-add-modal() => {
                root.totp-edit-id = "";
                root.totp-name = "";
                root.totp-issuer = "";
                root.totp-secret = "";
                root.qr-scan-error = "";
                root.qr-scanned-account = "";
                root.qr-scanned-secret = "";
                root.qr-scanned-issuer = "";
                root.show-totp-modal = true;
            }
            copy-code(id) => {
                root.copy-totp-code(id);
            }
            edit-totp(id) => {
                root.request-edit-totp(id);
            }
            request-context-menu(id, idx, x, y) => {
                root.context-menu-entry-id = id;
                root.context-menu-entry-index = idx;
                root.context-menu-x = x + 240px;
                root.context-menu-y = y;
                root.show-context-menu = true;
            }
        }

        // 3. Trash Tab
        if (root.current-filter == "trash"): TrashTab {
            horizontal-stretch: 0;
            width: 300px;
            entries: root.entries;
            selected-entry-id: root.selected-entry-id;
            current-search: root.current-search;
            search(query) => {
                root.current-search = query;
                root.perform-search(query, "trash");
            }
            select-entry(id) => {
                root.select-entry(id);
                root.show-context-menu = false;
            }
            request-context-menu(id, idx, x, y) => {
                root.context-menu-entry-id = id;
                root.context-menu-entry-index = idx;
                root.context-menu-x = x + 240px;
                root.context-menu-y = y;
                root.show-context-menu = true;
            }
        }

        // --- Detail Area (Accounts/Favorites/Trash only) ---
        // Note: TOTP view (current-filter == "totp") does NOT have a detail panel in this design (it uses cards).
        // But Trash view DOES have a detail panel, so we need to support logic for both Account and TOTP in Trash.
        if (root.current-filter != "totp"): DetailPanel {
            has-selection: root.has-selection;
            selected-entry-id: root.selected-entry-id;
            // Cached properties mapping
            sel-title: root.sel-title;
            sel-username: root.sel-username;
            sel-url: root.sel-url;
            sel-icon-text: root.sel-icon-text;
            sel-icon: root.sel-icon;
            sel-has-icon: root.sel-has-icon;
            sel-deleted: root.sel-deleted;
            sel-has-totp: root.sel-has-totp;
            sel-totp-code: root.sel-totp-code;
            entry_type: root.sel-entry-type; // Passed to detail panel for conditional rendering
            sel-notes: root.sel-notes;
            
            // Password reveal state
            revealed-password <=> root.revealed-password;
            is-password-revealed <=> root.is-password-revealed;
            totp-progress: root.totp-progress;

            // Callbacks

            edit-entry(id, title, user, url) => {
                root.request-edit-entry(id);
            }
            restore-entry(id) => {
                root.restore-entry(id);
                root.select-entry("");
            }
            delete-entry(id) => {
                root.delete-entry(id);
                root.select-entry("");
            }
            trash-entry(id) => {
                root.delete-entry(id);
                root.select-entry("");
            }
            copy-username(id) => {
                root.copy-username(id);
            }
            copy-password(id) => {
                root.copy-password(id);
            }
            reveal-password(id) => {
                root.reveal-password(id);
            }
            copy-to-clipboard(t) => {
                root.copy-to-clipboard(t);
            }
            copy-totp-code(id) => {
                root.copy-totp-code(id);
            }
            confirm-delete(id) => {
                root.confirm-entry-id = id;
                root.show-confirm-dialog = true;
            }
            open-link-totp-modal => {
                root.link-target-account-id = root.selected-entry-id;
                root.show-select-totp-modal = true;
                root.perform-search("", "totp"); // Load TOTPs for selection
            }
            unlink-totp(id) => {
                root.unlink-totp(id);
            }
            open-add-totp-modal => {
                root.totp-edit-id = "";
                // Pre-fill with account details for convenience
                root.totp-name = root.sel-username;
                root.totp-issuer = root.sel-title;
                root.totp-secret = "";
                root.qr-scan-error = "";
                root.qr-scanned-account = "";
                root.qr-scanned-secret = "";
                root.qr-scanned-issuer = "";
                // Pass linked account ID
                root.link-target-account-id = root.selected-entry-id;
                root.show-totp-modal = true;
            }
        }
    } // End HorizontalLayout



    // --- Context Menu Overlay ---
    if (root.show-context-menu): Rectangle {
        background: Colors.transparent;
        TouchArea {
            clicked => {
                root.show-context-menu = false;
            }
        }

        Rectangle {
            x: root.context-menu-x;
            y: root.context-menu-y;
            width: 200px;
            background: Theme.surface;
            border-radius: Theme.border-radius;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 6px;
                spacing: 2px;
                ContextMenuItem {
                    label: "Copy Username";
                    icon: @image-url("../../../assets/copy.svg");
                    clicked => {
                        root.copy-username(root.context-menu-entry-id);
                        root.show-context-menu = false;
                    }
                }

                ContextMenuItem {
                    label: "Copy Password";
                    icon: @image-url("../../../assets/lock.svg");
                    clicked => {
                        root.copy-password(root.context-menu-entry-id);
                        root.show-context-menu = false;
                    }
                }

                Divider { }

                ContextMenuItem {
                    label: "Edit";
                    icon: @image-url("../../../assets/edit.svg");
                    clicked => {
                        // Use callback instead of loop
                        let d = root.get-entry-details(root.context-menu-entry-id);
                        if (d.id == root.context-menu-entry-id) {
                            if (d.entry_type == "totp") {
                                root.request-edit-totp(d.id);
                            } else {
                                root.request-edit-entry(d.id);
                            }
                        }
                        root.show-context-menu = false;
                    }
                }

                Divider { }

                if (root.current-filter == "trash"): ContextMenuItem {
                    label: "Restore";
                    icon: @image-url("../../../assets/vault.svg");
                    text-color: Theme.success;
                    clicked => {
                        root.restore-entry(root.context-menu-entry-id);
                        root.show-context-menu = false;
                    }
                }
                if (root.current-filter == "trash"): ContextMenuItem {
                    label: "Delete Permanently";
                    icon: @image-url("../../../assets/trash.svg");
                    text-color: Theme.danger;
                    clicked => {
                        root.confirm-entry-id = root.context-menu-entry-id;
                        root.show-confirm-dialog = true;
                        root.show-context-menu = false;
                    }
                }
                if (root.current-filter != "trash"): ContextMenuItem {
                    label: "Move to Trash";
                    icon: @image-url("../../../assets/trash.svg");
                    text-color: Theme.danger;
                    clicked => {
                        root.delete-entry(root.context-menu-entry-id);
                        root.select-entry("");
                        root.show-context-menu = false;
                    }
                }
            }
        }
    }

    // --- Confirm Delete Dialog ---
    if (root.show-confirm-dialog): ConfirmDialog {
        title: "Delete Permanently?";
        message: "This entry will be permanently deleted. This action cannot be undone.";
        confirm-text: "Delete";
        cancel-text: "Cancel";
        confirmed => {
            root.delete-entry(root.confirm-entry-id);
            root.select-entry("");
            root.show-confirm-dialog = false;
        }
        cancelled => {
            root.show-confirm-dialog = false;
        }
    }

    // --- Add/Edit Account Modal ---
    if (root.show-modal): AccountModal {
        edit-id <=> root.edit-id;
        edit-title <=> root.edit-title;
        edit-username <=> root.edit-username;
        edit-password <=> root.edit-password;
        edit-url <=> root.edit-url;
        edit-notes <=> root.edit-notes;
        save(id, title, user, pass, url, notes) => {
            root.save-entry(id, title, user, pass, url, notes);
        }
        generate-password-from-settings => {
            root.generate-password-from-settings()
        }
        save-generator-settings(l, u, lo, n, s) => {
            root.save-generator-settings(l, u, lo, n, s);
        }
        get-generator-settings => {
            root.get-generator-settings()
        }
        close => {
            root.show-modal = false;
        }
    }

    // --- Add/Edit TOTP Modal ---
    if (root.show-totp-modal): TotpModal {
        edit-id <=> root.totp-edit-id;
        name <=> root.totp-name;
        issuer <=> root.totp-issuer;
        secret <=> root.totp-secret;
        // QR scan results
        scan-error: root.qr-scan-error;
        scanned-account: root.qr-scanned-account;
        scanned-secret: root.qr-scanned-secret;
        scanned-issuer: root.qr-scanned-issuer;
        save(id, n, s, i) => {
            // If we opened this with a target account, pass it
            root.save-totp(id, n, s, i, root.link-target-account-id);
            // Reset target after save
            root.link-target-account-id = "";
        }
        scan-screen => {
            root.scan-qr-from-screen();
        }
        scan-clipboard => {
            root.scan-qr-from-clipboard();
        }
        scan-file => {
            root.scan-qr-from-file();
        }
        close => {
            root.show-totp-modal = false;
            root.link-target-account-id = "";
        }
    }

    // --- Select TOTP Modal ---
    if (root.show-select-totp-modal): SelectTotpModal {
        entries: root.entries; // Should be filtered to TOTPs eventually, or we assume logic handles it?
        // Note: The parent needs to ensure `entries` contains TOTPs when this modal is open.
        // We called perform-search("", "totp") when opening, so it should be fine.
        
        select(totp-id) => {
            root.link-totp(totp-id, root.link-target-account-id);
            root.show-select-totp-modal = false;
            root.link-target-account-id = "";
            // Restore detailed view of account
            root.select-entry(root.selected-entry-id);
        }
        search(q) => {
            root.perform-search(q, "totp");
        }
        close => {
            root.show-select-totp-modal = false;
            root.link-target-account-id = "";
            // Restore detailed view of account
             root.select-entry(root.selected-entry-id);
        }
    }
}
