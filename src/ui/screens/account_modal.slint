// Account Add/Edit Modal
import { VaultEntryData, GeneratorSettings } from "../types.slint";
import { Theme } from "../theme.slint";
import {
    PrimaryButton,
    SecondaryButton,
    Divider,
    Label,
    IconButton,
} from "../components.slint";
import { GeneratorBubble } from "../components/generator_bubble.slint";
import { ScrollView, LineEdit, TextEdit } from "std-widgets.slint";

export component AccountModal inherits Rectangle {
    in-out property <string> edit-id: "";
    in-out property <string> edit-title: "";
    in-out property <string> edit-username: "";
    in-out property <string> edit-password: "";
    in-out property <string> edit-url: "";
    in-out property <string> edit-notes: "";
    in-out property <bool> show-generator-bubble: false;
    property <GeneratorSettings> bubble-settings: {
        length: 16,
        include_uppercase: true,
        include_lowercase: true,
        include_numbers: true,
        include_symbols: true
    };

    // Generator Callbacks
    callback generate-password-from-settings() -> string;
    callback save-generator-settings(int, bool, bool, bool, bool);
    callback get-generator-settings() -> GeneratorSettings;
    callback save(string, string, string, string, string, string); // id, title, username, password, url, notes
    callback close;
    background: rgba(0, 0, 0, 0.6);
    TouchArea {
        clicked => {
            if (root.show-generator-bubble) {
                root.show-generator-bubble = false;
            } else {
                root.close();
            }
        }
    }

    Rectangle {
        width: 440px;
        height: 480px;
        background: Theme.surface;
        border-radius: Theme.border-radius-xl;
        border-width: 1px;
        border-color: Theme.border;
        TouchArea { }

        VerticalLayout {
            padding: 28px;
            spacing: 20px;

            // Modal Header
            HorizontalLayout {
                spacing: 12px;
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 10px;
                    background: Theme.primary-glow;
                    Image {
                        source: root.edit-id == "" ? @image-url("../../../assets/plus.svg") : @image-url("../../../assets/edit.svg");
                        width: 20px;
                        height: 20px;
                        colorize: Theme.primary;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: root.edit-id == "" ? "Add Account" : "Edit Account";
                        font-size: Theme.font-size-h2;
                        font-weight: 800;
                        color: Theme.text-primary;
                    }

                    Text {
                        text: root.edit-id == "" ? "Create a new password entry" : "Update account details";
                        font-size: Theme.font-size-small;
                        color: Theme.text-muted;
                    }
                }
            }

            Divider { }

            ScrollView {
                VerticalLayout {
                    spacing: 14px;
                    padding-right: 12px; // Space for scrollbar

                    // Title
                    VerticalLayout {
                        spacing: 6px;
                        Label {
                            text: "TITLE";
                        }

                        LineEdit {
                            text <=> root.edit-title;
                            placeholder-text: "e.g. Google, Amazon";
                            font-size: 13px;
                        }
                    }

                    // Username
                    VerticalLayout {
                        spacing: 6px;
                        Label {
                            text: "USERNAME";
                        }

                        LineEdit {
                            text <=> root.edit-username;
                            placeholder-text: "username@example.com";
                            font-size: 13px;
                        }
                    }

                    // Password
                    VerticalLayout {
                        spacing: 6px;
                        Label {
                            text: "PASSWORD";
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            height: 32px;
                            LineEdit {
                                horizontal-stretch: 1;
                                height: 100%;
                                text <=> root.edit-password;
                                placeholder-text: "Secret Password";
                                font-size: 13px;
                            }
                            
                            // Dice Icon Button
                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: 4px;
                                background: dice-touch.has-hover ? Theme.surface-hover : Theme.surface;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                dice-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.edit-password = root.generate-password-from-settings();
                                    }
                                    pointer-event(event) => {
                                        if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                                            root.bubble-settings = root.get-generator-settings();
                                            root.show-generator-bubble = !root.show-generator-bubble;
                                        }
                                    }
                                }

                                Image {
                                    source: @image-url("../../../assets/generator.svg");
                                    width: 18px;
                                    height: 18px;
                                    colorize: Theme.text-secondary;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                    }

                    // Website
                    VerticalLayout {
                        spacing: 6px;
                        Label {
                            text: "WEBSITE";
                        }

                        LineEdit {
                            text <=> root.edit-url;
                            placeholder-text: "https://...";
                            font-size: 13px;
                        }
                    }

                    // Notes
                    VerticalLayout {
                        spacing: 6px;
                        Label {
                            text: "NOTES";
                        }

                        TextEdit {
                            text <=> root.edit-notes;
                            font-size: 13px;
                            height: 80px; 
                            // TextEdit in Slint 1.9 might not support placeholder-text directly or it might be different.
                            // But basic TextEdit is fine.
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 10px;
                alignment: end;
                SecondaryButton {
                    text: "Cancel";
                    width: 100px;
                    clicked => {
                        root.close();
                    }
                }

                PrimaryButton {
                    text: root.edit-id == "" ? "Add Account" : "Save Changes";
                    width: 140px;
                    enabled: root.edit-title != "";
                    clicked => {
                        root.save(root.edit-id, root.edit-title, root.edit-username, root.edit-password, root.edit-url, root.edit-notes);
                        root.close();
                    }
                }
            }
        }

        if (root.show-generator-bubble): GeneratorBubble {
            x: 160px;
            y: 200px;
            
            // Initialize with current settings when shown
            length: root.bubble-settings.length;
            include_uppercase: root.bubble-settings.include_uppercase;
            include_lowercase: root.bubble-settings.include_lowercase;
            include_numbers: root.bubble-settings.include_numbers;
            include_symbols: root.bubble-settings.include_symbols;
            settings-changed(l, u, lo, n, s) => {
                root.save-generator-settings(l, u, lo, n, s);
            }
            close-requested => {
                root.show-generator-bubble = false;
            }
        }
    }
}
