export global Theme {
    // --- Palette (Slate/Blue Premium Dark) ---
    // --- Mode ---
    in-out property <string> mode: "system"; // "light", "dark", "system"
    in-out property <bool> system-is-dark: true; // Default to dark until detected
    out property <bool> dark-mode: root.mode == "dark" || (root.mode == "system" && root.system-is-dark);

    // --- Dynamic Palette ---
    in-out property <color> background: root.dark-mode ? #0F1115 : #F8FAFC;
    in-out property <color> background-alt: root.dark-mode ? #0A0C0F : #F1F5F9;
    in-out property <color> surface: root.dark-mode ? #1C1F26 : #FFFFFF;
    in-out property <color> surface-subtle: root.dark-mode ? #252932 : #F1F5F9;
    in-out property <color> surface-hover: root.dark-mode ? #2D333D : #E2E8F0;
    in-out property <color> surface-elevated: root.dark-mode ? #1E222A : #FFFFFF;
    in-out property <color> primary: root.dark-mode ? #3B82F6 : #2563EB;
    in-out property <color> primary-deep: root.dark-mode ? #2563EB : #1D4ED8;
    in-out property <color> primary-soft: root.dark-mode ? #1D4ED8 : #DBEAFE;
    in-out property <color> primary-glow: root.dark-mode ? rgba(59, 130, 246, 0.15) : rgba(37, 99, 235, 0.1);
    in-out property <color> primary-glow-strong: root.dark-mode ? rgba(59, 130, 246, 0.25) : rgba(37, 99, 235, 0.2);
    in-out property <color> accent: #8B5CF6;
    in-out property <color> accent-glow: root.dark-mode ? rgba(139, 92, 246, 0.12) : rgba(139, 92, 246, 0.1);
    in-out property <color> danger: #EF4444;
    in-out property <color> danger-soft: root.dark-mode ? rgba(239, 68, 68, 0.12) : rgba(254, 226, 226, 0.5);
    in-out property <color> success: #10B981;
    in-out property <color> success-soft: root.dark-mode ? rgba(16, 185, 129, 0.12) : rgba(209, 250, 229, 0.5);
    in-out property <color> warning: #F59E0B;
    in-out property <color> warning-soft: root.dark-mode ? rgba(245, 158, 11, 0.12) : rgba(254, 243, 199, 0.5);
    in-out property <color> text-primary: root.dark-mode ? #F8FAFC : #0F172A;
    in-out property <color> text-secondary: root.dark-mode ? #94A3B8 : #475569;
    in-out property <color> text-muted: #64748B;
    in-out property <color> text-disabled: root.dark-mode ? #475569 : #94A3B8;
    in-out property <color> border: root.dark-mode ? #2E333D : #E2E8F0;
    in-out property <color> border-bright: root.dark-mode ? #3F444E : #CBD5E1;
    in-out property <color> border-subtle: root.dark-mode ? #222730 : #F1F5F9;
    
    // Shadow simulation
    in-out property <color> shadow-color: root.dark-mode ? rgba(0, 0, 0, 0.3) : rgba(0, 0, 0, 0.05);
    
    // --- Metrics ---
    in-out property <length> border-radius: 8px;
    in-out property <length> border-radius-xs: 4px;
    in-out property <length> border-radius-sm: 6px;
    in-out property <length> border-radius-lg: 12px;
    in-out property <length> border-radius-xl: 16px;
    in-out property <length> border-radius-pill: 999px;
    in-out property <length> padding-xs: 4px;
    in-out property <length> padding-sm: 8px;
    in-out property <length> padding-md: 16px;
    in-out property <length> padding-lg: 24px;
    in-out property <length> padding-xl: 32px;

    // --- Typography ---
    in-out property <string> font-family: "Inter";
    in-out property <length> font-size-display: 36px;
    in-out property <length> font-size-h1: 28px;
    in-out property <length> font-size-h2: 20px;
    in-out property <length> font-size-h3: 16px;
    in-out property <length> font-size-body: 14px;
    in-out property <length> font-size-small: 12px;
    in-out property <length> font-size-xs: 10px;
    in-out property <length> font-size-xl: 24px;
}
