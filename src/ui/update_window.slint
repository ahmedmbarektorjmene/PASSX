import { Theme } from "theme.slint";
import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component UpdateWindow inherits Window {
    title: "Update Ready";
    width: 420px;
    height: 220px;
    background: Theme.background;
    always-on-top: true;
    in property <string> new-version: "";
    callback restart-now();
    callback remind-later();
    VerticalBox {
        padding: Theme.padding-md;
        spacing: Theme.padding-md;
        Text {
            text: "Update Downloaded!";
            font-size: Theme.font-size-h2;
            color: Theme.text-primary;
            horizontal-alignment: center;
        }

        Text {
            text: "Version " + root.new-version + " has been downloaded.\nRestart PASSX to apply the update.";
            font-size: Theme.font-size-body;
            color: Theme.text-secondary;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        HorizontalBox {
            alignment: center;
            spacing: Theme.padding-md;
            Button {
                text: "Later";
                clicked => {
                    root.remind-later();
                }
            }

            Button {
                text: "Restart Now";
                primary: true;
                clicked => {
                    root.restart-now();
                }
            }
        }
    }
}
