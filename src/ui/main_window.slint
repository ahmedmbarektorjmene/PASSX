import { Theme } from "theme.slint";
import { Palette } from "std-widgets.slint";
import { LaunchScreen } from "./screens/launch.slint";

import { UnlockScreen } from "./screens/unlock.slint";
import { MainVaultScreen } from "./screens/main_vault.slint";
import { VaultEntryData, GeneratorSettings } from "types.slint";
import { PasswordGeneratorScreen } from "./screens/generator.slint";
import { SettingsScreen } from "./screens/settings.slint";
import { VaultListScreen } from "./screens/vault_list.slint";
import { UpdateWindow } from "update_window.slint";

export { VaultEntryData, GeneratorSettings, MainWindow, UpdateWindow }

component MainWindow inherits Window {
    title: "PassX — Secure Vault";
    icon: @image-url("../../assets/icons/icon-48x48.png");
    default-font-family: Theme.font-family;
    default-font-size: Theme.font-size-body;
    preferred-width: 1050px;
    preferred-height: 720px;
    background: Theme.background;

    // Sync Slint's built-in Palette with our Theme so standard widgets
    // (LineEdit, ScrollView, etc.) respect light/dark mode
    init => {
        Palette.color-scheme = Theme.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }

    // Window resize constraints
    min-width: 800px;
    min-height: 550px;
    max-width: 1600px;
    max-height: 1000px;

    // Logic State
    // 0: Launch, 1: Create, 2: Unlock, 3: Main, 5: Generator, 6: Settings, 7: Vault List
    in-out property <int> current-screen: 0;
    in-out property <string> vault-path: "";
    in-out property <string> error-message: "";
    in-out property <[VaultEntryData]> vault-entries: [];
    in-out property <string> selected-entry-id: "";
    in-out property <string> revealed-password: "";
    in-out property <bool> is-password-revealed: false;
    in-out property <float> totp-progress: 0.0;
    in-out property <bool> show-totp-modal: false;

    // Environment
    in property <bool> tpm-available: true;

    // Callbacks
    callback browse-for-new-vault();
    callback browse-for-existing-vault();
    callback create-new-vault-confirmed(string, int);
    callback attempt-unlock(string);
    callback lock-vault();
    callback copy-password(string);
    callback copy-username(string);
    callback save-totp(string, string, string, string, string); // id, name, secret, issuer, linked_account_id
    callback link-totp(string, string); // totp_id, account_id
    callback unlink-totp(string); // account_id
    callback delete-entry(string);
    callback restore-entry(string);
    callback save-entry(string, string, string, string, string, string); // id, title, username, password, url, notes
    callback perform-search(string, string);
    callback select-entry(string);
    callback reveal-password(string);
    callback generate-password(int, bool, bool, bool, bool) -> string;
    callback generate-password-from-settings() -> string;
    callback save-generator-settings(int, bool, bool, bool, bool);
    callback get-generator-settings() -> GeneratorSettings;
    callback copy-to-clipboard(string);
    callback get-entry-details(string) -> VaultEntryData;
    callback copy-totp-code(string);

    // Secure Edit Handshake Properties
    in-out property <string> auth-edit-id: "";
    in-out property <int> auth-edit-tick: 0;
    in-out property <string> auth-totp-id: "";
    in-out property <int> auth-totp-tick: 0;

    // Secure Edit Callbacks (Bridge)
    callback request-edit-entry(string);
    callback request-edit-totp(string);
    public function authorized-edit-entry(id: string) {
        root.auth-edit-id = id;
        root.auth-edit-tick += 1;
    }
    public function authorized-edit-totp(id: string) {
        root.auth-totp-id = id;
        root.auth-totp-tick += 1;
    }

    // QR Code Scanning
    callback scan-qr-from-screen();
    callback scan-qr-from-clipboard();
    callback scan-qr-from-file();
    in-out property <string> qr-scan-error: "";
    in-out property <string> qr-scanned-account: "";
    in-out property <string> qr-scanned-secret: "";
    in-out property <string> qr-scanned-issuer: "";

    // Import/Export
    callback export-passwords();
    callback export-totps();
    callback import-passwords();
    callback import-totps();
    callback change-master-password(string, string); // current, new
    in-out property <string> io-status-message: "";

    // Vault Management
    in-out property <[string]> managed-vaults: [];
    callback refresh-managed-vaults();
    callback open-managed-vault(string);
    callback delete-managed-vault(string);
    callback create-managed-vault(string, string, int);

    // Mirroring
    in-out property <[string]> vault-mirrors: [];
    callback add-mirror();
    callback remove-mirror(int);
    callback sync-mirrors();

    // Theme
    in-out property <string> theme-mode <=> Theme.mode;
    callback save-theme(string);

    // --- Screen Logic ---

    // 0: Launch
    if (root.current-screen == 0): LaunchScreen {
        width: 100%;
        height: 100%;
        create-new-vault => {
            root.vault-path = "";
            root.error-message = "";
            root.current-screen = 1;
        }
        open-existing-vault => {
            // Hijacked: Go to Vault List
            root.refresh-managed-vaults();
            root.current-screen = 7;
        }
    }

    // 1: Create
    // Removed


    // 2: Unlock
    if (root.current-screen == 2): UnlockScreen {
        width: 100%;
        height: 100%;
        vault-path: root.vault-path;
        error-message: root.error-message;
        unlock(pw) => {
            root.attempt-unlock(pw);
        }
        back => {
            root.current-screen = 0;
        }
    }

    // 3: Main UI
    if (root.current-screen == 3): MainVaultScreen {
        width: 100%;
        height: 100%;
        entries: root.vault-entries;
        // Bind auth signals
        auth-edit-id: root.auth-edit-id;
        auth-edit-tick: root.auth-edit-tick;
        auth-totp-id: root.auth-totp-id;
        auth-totp-tick: root.auth-totp-tick;
        lock-vault => {
            root.lock-vault();
        }
        save-entry(id, title, user, pass, url, notes) => {
            root.save-entry(id, title, user, pass, url, notes);
        }
        perform-search(q, f) => {
            root.perform-search(q, f);
        }
        delete-entry(id) => {
            root.delete-entry(id);
        }
        restore-entry(id) => {
            root.restore-entry(id);
        }
        copy-username(id) => {
            root.copy-username(id);
        }
        copy-password(id) => {
            root.copy-password(id);
        }
        select-entry(id) => {
            root.select-entry(id);
            root.is-password-revealed = false;
            root.revealed-password = "";
        }
        reveal-password(id) => {
            root.reveal-password(id);
        }
        selected-entry-id: root.selected-entry-id;
        revealed-password <=> root.revealed-password;
        is-password-revealed <=> root.is-password-revealed;
        totp-progress: root.totp-progress;
        open-generator => {
            root.current-screen = 5;
        }
        open-settings => {
            root.current-screen = 6;
        }
        copy-to-clipboard(t) => {
            root.copy-to-clipboard(t);
        }
        save-totp(id, acc, sec, iss, link) => {
            root.save-totp(id, acc, sec, iss, link);
        }
        link-totp(totp-id, acc-id) => {
            root.link-totp(totp-id, acc-id);
        }
        unlink-totp(id) => {
            root.unlink-totp(id);
        }
        get-entry-details(id) => {
            return root.get-entry-details(id);
        }
        copy-totp-code(id) => {
            root.copy-totp-code(id);
        }
        request-edit-entry(id) => {
            root.request-edit-entry(id);
        }
        request-edit-totp(id) => {
            root.request-edit-totp(id);
        }
        // QR Scanning
        scan-qr-from-screen => {
            root.scan-qr-from-screen();
        }
        scan-qr-from-clipboard => {
            root.scan-qr-from-clipboard();
        }
        scan-qr-from-file => {
            root.scan-qr-from-file();
        }
        qr-scan-error <=> root.qr-scan-error;
        qr-scanned-account <=> root.qr-scanned-account;
        qr-scanned-secret <=> root.qr-scanned-secret;
        qr-scanned-issuer <=> root.qr-scanned-issuer;
        show-totp-modal <=> root.show-totp-modal;
        
        // Generator wiring
        generate-password-from-settings => {
            root.generate-password-from-settings()
        }
        get-generator-settings => {
            root.get-generator-settings()
        }
        save-generator-settings(l, u, lo, n, s) => {
            root.save-generator-settings(l, u, lo, n, s);
        }
    }

    // 5: Generator
    if (root.current-screen == 5): PasswordGeneratorScreen {
        width: 100%;
        height: 100%;
        back => {
            root.current-screen = 3;
        }
        generate-password(l, u, lo, n, s) => {
            return root.generate-password(l, u, lo, n, s);
        }
        copy-to-clipboard(t) => {
            root.copy-to-clipboard(t);
        }
        get-generator-settings => {
            root.get-generator-settings()
        }
        save-generator-settings(l, u, lo, n, s) => {
            root.save-generator-settings(l, u, lo, n, s);
        }
    }

    // 6: Settings
    if (root.current-screen == 6): SettingsScreen {
        width: 100%;
        height: 100%;
        status-message: root.io-status-message;
        mirrors: root.vault-mirrors; // Bind mirrors
        
        back => {
            root.current-screen = 3;
        }
        export-passwords => {
            root.export-passwords();
        }
        export-totps => {
            root.export-totps();
        }
        import-passwords => {
            root.import-passwords();
        }
        import-totps => {
            root.import-totps();
        }
        change-master-password(current, new) => {
            root.change-master-password(current, new);
        }
        add-mirror => {
            root.add-mirror();
        }
        remove-mirror(idx) => {
            root.remove-mirror(idx);
        }
        sync-mirrors => {
            root.sync-mirrors();
        }
        
        // Theme Wiring
        current-mode: root.theme-mode;
        set-mode(m) => {
            root.theme-mode = m;
            root.save-theme(m);
            Palette.color-scheme = Theme.dark-mode ? ColorScheme.dark : ColorScheme.light;
        }
    }

    // 7: Vault List
    if (root.current-screen == 7): VaultListScreen {
        width: 100%;
        height: 100%;
        vaults: root.managed-vaults;
        back => {
            root.current-screen = 0;
        }
        open-vault(name) => {
            root.open-managed-vault(name);
            // open-managed-vault should set vault-path and switch screen to 2 (Unlock) if successful? 
            // Or we do it here?
            // The callback can't change properties directly if implemented in Rust.
            // But usually we trigger rust, rust updates properties.
            // Rust will set current-screen = 2.
        }
        create-new => {
            root.current-screen = 1; // Wait, we use modal in screen 7 now?
            // If Create New triggers modal in screen 7, we don't need to change screen?
            // The callbacks in VaultListScreen: 
            // create-new -> opens modal (internal)
            // But create-new was calling root.create-new in MainWindow?
            // In VaultListScreen: callback create-new(); is used to trigger modal?
            // Ah, I set root.show-create-modal = true in the VaultListScreen logic itself!
            // So create-new callback might NOT be needed if handles internally?
            // But I exposed it.
            // Let's check VaultListScreen again.
            // "clicked => { root.show-create-modal = true; ... }"
            // It does NOT emit create-new() signal.
            // So I can remove create-new callback from VaultListScreen or ignore it.
        }
        create-managed-vault(name, pass, mode) => {
            root.create-managed-vault(name, pass, mode);
        }
        open-external => {
            root.browse-for-existing-vault();
        }
        delete-vault(name) => {
            root.delete-managed-vault(name);
        }
    }
}
